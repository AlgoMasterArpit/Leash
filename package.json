{
  "name": "leash",
  "version": "1.0.0",
  "description": "Spend controls for AI agents, powered by PayPal",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/server.js",
    "mcp": "node src/mcp.js",
    "test": "node --test \"test/**/*.test.js\"",
    "webhook:register": "node --env-file-if-exists=.env scripts/register-webhook.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "leash-mcp": "src/mcp.js"
  }
}
